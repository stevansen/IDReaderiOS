<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Ohne dieses Recht gibt es keine Lesesitzung. Es haengt am
		Entwicklerkonto: „NFC Tag Reading" muss fuer die App-ID eingeschaltet
		sein, sonst laesst sich das Ziel nicht signieren.

		Bewusst nur TAG und nicht NDEF: die App liest eine Chipkarte, keine
		beschriebenen Aufkleber.
	-->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
